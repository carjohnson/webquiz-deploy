#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('webquizproject:server');
var server;

const isRender = process.env.RENDER === 'true';  // true on Render, false local

/**
 * Render the environment-specific viewer config from its template
 * before the app starts serving the static build. Cross-platform,
 * no shell/sed dependency, runs identically on Render and locally.
 */
renderViewerConfig();

/**
 * Get port from environment and store in Express.
 */
const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);


if (isRender) {
  server = app.listen(port, '0.0.0.0');
} else {
  // local: HTTPS with certs
  const https = require('https');
  const fs = require('fs');
  const path = require('path');
  /**
   * Load certificates
   */
  const certPath = path.join(__dirname, '../certs');
  // same certs also used in ohif viewer (common name set as CN=localhost)
  const options = {
    key: fs.readFileSync(path.join(certPath, 'nginx.key')),
    cert: fs.readFileSync(path.join(certPath, 'nginx.crt'))
  };
  server = https.createServer(options, app);
} 

/**
 * Listen on provided port, on all network interfaces.
 */
server.listen(port, () => {
  console.log(`🚀 Server listening on port ${port}`);
});
server.on('error', onError);
server.on('listening', onListening);


// >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  
  // Attach the upgrade handler AFTER server.listen()
  server.on('upgrade', (req, socket, head) => {
    if (req.url.startsWith('/ws')) {
      // console.log('Forwarding WebSocket upgrade for:', req.url);
      wsProxy(req, socket, head);
    }
  });
// }


// >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
/**
 * Render app-config.js in place, substituting {{VAR_NAME}} placeholders
 * with the matching environment variable. OHIF's build (via APP_CONFIG=
 * config/webquizConfig.template.js) copies the template to this exact
 * path and filename, placeholders intact, so template and output are
 * the same file here - this runs once per fresh deploy, before the
 * placeholder-filled file is ever served. Only variables that are
 * actually set are substituted, so a missing env var causes a loud
 * failure rather than silently writing "undefined" into the deployed
 * config.
 */
function renderViewerConfig() {
  const fs = require('fs');
  const path = require('path');

  // This is where OHIF's build places app-config.js - adjust only if
  // your static output directory differs from public/ohif.
  const templatePath = path.join(__dirname, '../public/ohif/app-config.js');
  const outputPath = templatePath;

  if (!fs.existsSync(templatePath)) {
    debug('No app-config.js found at %s, skipping render', templatePath);
    return;
  }

  let contents = fs.readFileSync(templatePath, 'utf8');
  const placeholders = contents.match(/{{\s*[A-Z0-9_]+\s*}}/g) || [];

  if (placeholders.length === 0) {
    // Already rendered (or a restart of the same instance, not a fresh
    // deploy) - nothing left to substitute, safe to no-op.
    return;
  }

  const missing = [];

  placeholders.forEach(placeholder => {
    const varName = placeholder.replace(/[{}\s]/g, '');
    const value = process.env[varName];
    if (value === undefined) {
      missing.push(varName);
      return;
    }
    contents = contents.split(placeholder).join(value);
  });

  if (missing.length > 0) {
    // Fail loudly rather than deploying a viewer that silently points nowhere.
    console.error(`Missing required env vars for viewer config: ${missing.join(', ')}`);
    process.exit(1);
  }

  fs.writeFileSync(outputPath, contents);
  console.log(`✅ Rendered viewer config -> ${outputPath}`);
}

// >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

// >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

// >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
