extends layout

block content
  .login-container
    header
      img.logo(src="/assets/baineslogo.png", alt="Your Company Logo")
      h1 Baines Imaging - Radiology Coach
    p Welcome to #[em Baines Imaging - Radiology Coach], a web-based learning tool.
    h2= title

    form(action="/users/login", method="POST")
      fieldset
        div.form-group
          label(for="email") Email ID
          input#email(type="email", name="email", placeholder="abc@example.com", required)

        div.form-group
          label(for="password") Password
          input#password(type="password", name="password", required)

        div.button-group
          button(type="reset") Reset
          button(type="submit") Submit

        br
        a#registerlink(href="/users/register") Register

    h3(style="color: #FF9500")= msg