extends ../layout

block content
  h2= title
  if message
    h5= message

  form#backupForm(action="/manager/backup", method="POST")
    label(for="outputDir") Backup output directory
    input#outputDir(type="text", name="outputDir", required, style="width: 400px")
    br
    br
    button(type="submit") Run backup
    br
    br
    a(href="/manager") Return


  if errmessage
    br
    br
    h4(style="color: #FF9500")= errmessage

