extends ../layout

block content
  h1= title
  if message
    p= message

  form#backupForm(action="/manager/backup", method="POST")
    label(for="outputDir") Backup output directory
    input#outputDir(type="text", name="outputDir", required)
    br
    br
    button(type="submit") Run backup

  if errmessage
    br
    br
    h4(style="color: #FF9500")= errmessage

