extends ../layout

block content
  h1 Backup Status

  if status === "success" && zipFileName
    p Backup completed successfully.
    p #{successCount} segmentation files copied.
    a.level2-button(href=`/manager/backup/download/${zipFileName}`) Download ZIP

  if status === "partial"
    p(style="color: orange; font-weight: bold") Backup completed with warnings.
    p #{successCount} files copied successfully.
    p #{failCount} files failed to copy.
    p Please check the server log file for details.

    if failures.length
      h3 Failed Files
      ul
        each f in failures
          li
            | Segmentation ID: #{f.segmentationId}
            br
            | Source: #{f.source}
            br
            | Error: #{f.error}

  if status === "error"
    p(style="color: red; font-weight: bold") Backup failed.
    p Error: #{error}

  br
  br
  a.button(href="/manager") Return to Manager
