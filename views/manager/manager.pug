extends ../layout

block content
  .index-container
    header
      .header-top
        img(src="/assets/baineslogo.png", alt="Baines Imaging Logo", class="logo")
        span.company-name Baines Imaging

    h2.page-title= title

    .content-area
      if message
        h4= message

      // ============================
      //   DATABASE GROUP
      // ============================
      .task-group
        h3.task-title Database

        form(action="/manager/backup", method="get")
          button.manager-button(type="submit") Backup database

        form(action="/manager/restore", method="get")
          button.manager-button(type="submit") Restore database

      // ============================
      //   USER GROUP
      // ============================
      .task-group
        h3.task-title User

        form(action="/manager/user-management", method="get")
          button.manager-button(type="submit") Manage users (reset password / authorize)


        form(action="/manager/report-progress", method="get")
          button.manager-button(type="submit") Get user progress report

      // ============================
      //   PACS GROUP
      // ============================
      .task-group
        h3.task-title PACS

        form(action="/manager/scrape-pacs-post", method="post")
          button.manager-button(type="submit") Scrape PACS

        form(action="/manager/upload-pacs-folder-post", method="post")
          button.manager-button(type="submit") Upload studies folder to PACS

        form(action="/manager/upload-db-studies-post", method="post")
          button.manager-button(type="submit") Upload studies list to MongoDB

      // ============================
      //   EXIT BUTTON
      // ============================
      .task-group
        h3.task-title System

        form(action="/manager/exit-post", method="post")
          button.manager-button(type="submit") Exit
