extends ../layout

block content
  .login-container
    header
      img(src="/assets/baineslogo.png", alt="Baines Imaging Logo", class="logo")
      h1= title

    .content-area
      if message
        h4= message

      .link-group
        form(action="/manager/backup", method="get")
          button(type="submit") Backup database

        form(action="/manager/reset-user-password", method="get")
          button(type="submit") Reset user's password

        form(action="/manager/scrape-pacs-post", method="post")
          button(type="submit") Scrape PACS for list of Dicom studies and series

        form(action="/manager/upload-db-studies-post", method="post")
          button(type="submit") Upload studies list to database

        form(action="/manager/exit-post", method="post")
          button(type="submit") Exit