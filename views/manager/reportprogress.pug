//- views/manager/reportprogress.pug
h1= title
p= message

style.
  .monospace-table {
    font-family: monospace, Courier, "Courier New";
    border-collapse: collapse;
    width: auto;
    margin-top: 15px;
  }
  .monospace-table th, .monospace-table td {
    border: 1px solid #ccc;
    padding: 6px 12px;
    text-align: left;
    white-space: pre;
  }
  .monospace-table th {
    background-color: #f2f2f2;
    font-weight: bold;
  }
  .monospace-table tbody tr:nth-child(even) {
    background-color: #fafafa;
  }
  .status-cell {
    text-align: center;
  }

table.monospace-table
  thead
    tr
      th Study Name
      each user in allUsers
        th= user

  tbody
    if rows && rows.length
      each row in rows
        tr
          td= row.studyName
          each user in allUsers
            - const entry = row.statuses.find(s => s.username === user)
            td.status-cell= entry ? entry.studyStatus : '-'
    else
      tr
        td(colspan=allUsers.length + 1) No progress data available

br
br
a(href="/manager") Return