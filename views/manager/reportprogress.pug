h1= title
p= message

table.progress-report
  thead
    tr
      th Study Name
      each user in allUsers
        th= user

  tbody
    each row in rows
      tr
        td= row.studyName
        each user in allUsers
          - const entry = row.statuses.find(s => s.username === user)
          td= entry ? entry.studyStatus : ''
br
br
a(href="/manager") Return

