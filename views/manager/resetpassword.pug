extends ../layout

block content
  h2= title
  if message
    h5= message

  form#backupForm(action="/manager/reset-user-password", method="POST")
    label(for="userEmail") User email
    input#userEmail(type="email", name="userEmail", placeholder="abc@example.com", required)
    br
    label(for="newPassword") New password
    input#newPassword(type="text", name="newPassword", required)
    br
    br
    button(type="submit") Reset password
    br
    br
    a(href="/manager") Return

  if errmessage
    br
    br
    h4(style="color: #FF9500")= errmessage
