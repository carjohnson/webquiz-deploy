extends ../layout

block content
  h2= title
  if message
    h5(style="color: #4CAF50")= message

  form#backupForm(action="/manager/scrape-pacs-post", method="POST")
    button(type="submit") Run scrape PACS
    br
    br
    a(href="/manager") Return

  if errmessage
    br
    br
    h4(style="color: #FF9500")= errmessage