extends layout

block content
  <script src="/scripts/webquiz-listener.js"></script>

  script.
    const legend  = !{JSON.stringify(legend)};

  <br><br>
  <br><br>
  h4="Annotations"
  <br><br>
  <label><strong>Legend</strong></label>
  if legend && legend.length
    ul#annotation-legend
      each item in legend
        li(style=`color: ${item.color}`)
          | User #{item.index + 1} - #{item.user_name}
  else
    p No annotation legend available.
  h3(style="color: orange")=msg