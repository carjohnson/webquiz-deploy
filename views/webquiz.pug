extends layout

block content
  <script src="/scripts/webquiz-listener.js"></script>

  script.
    const legend  = !{JSON.stringify(legend)};
    
  <br><br>
  <br><br>
  h4(style="margin-top: 30px")="Annotations"
  <br><br>
  if legend && legend.length
    ul#annotation-legend
      each item in legend
        li(style=`color: ${item.color}`)
          | User #{item.index + 1} - #{item.user_name}
  else
    p No annotation legend available.
  <br><br>
  <br><br>
  h5 Suspicion Scores
  if suspicionScores && suspicionScores.length
    ul#score-list
      each score in suspicionScores
        li= score
  else
    p No suspicion scores available.

  h3(style="color: orange")=msg